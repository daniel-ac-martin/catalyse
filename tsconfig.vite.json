{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "*/*/src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "*/*/dist",
    "*/*/build",
    "*/*/node_modules"
  ]
}
